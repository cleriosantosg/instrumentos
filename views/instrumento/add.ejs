<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Adicionar Instrumento</title>
</head>
<body>
    <h1>Adicionar Novo Instrumento</h1>
    
    <form action="/instrumento/add/ok" method="POST">
        <div>
            <label>Nome:</label><br>
            <input type="text" name="nome" required>
        </div>
        <div>
            <label>Fabricante:</label><br>
            <input type="text" name="fabricante" required>
        </div>
        <div>
            <label>Preço (R$):</label><br>
            <input type="number" step="0.01" name="preco" required>
        </div>
        <div>
            <label>Tipo:</label><br>
            <input type="text" name="tipo" required>
        </div>
        <br>
        <button type="submit">Salvar Instrumento</button>
    </form>

    <br>
    <a href="/instrumento/lst">Voltar para a lista</a>
</body>
</html>
